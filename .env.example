# Google Gemini API Key (server-side only — never put in frontend/installer)
GEMINI_API_KEY="YOUR_API_KEY_HERE"

# PostgreSQL connection (required for AICA)
# Dev example below. Desktop production: put a hosted URL in %AppData%\AICA\config.env
# Example: postgresql://USER:PASSWORD@localhost:5432/aica_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aica_db"

# Optional session signing key (otherwise auto-generated per machine)
# AICA_SECRET_KEY=
