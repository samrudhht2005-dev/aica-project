# AICA Desktop — configuration template
# Copy ideas into: %AppData%\AICA\config.env
# NEVER commit real secrets to Git.
# NEVER leave USER / PASSWORD / HOST as live values — they will be ignored.

# Packaged desktop uses SQLite by default:
#   %AppData%\AICA\aica.db
# Uncomment only if you want hosted PostgreSQL instead:
# DATABASE_URL=postgresql://myuser:mypassword@db.example.com:5432/aica_db

# Uncomment for IRA / OCR / AI Optimization (server-side only):
# GEMINI_API_KEY=

# Optional: override auto-generated session secret (recommended in multi-device prod)
# AICA_SECRET_KEY=

# Desktop flags (set automatically by launcher; safe to leave)
AICA_DESKTOP=1
AICA_VERSION=1.0.2
